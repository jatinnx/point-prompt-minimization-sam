# DLRSD itself: 264 MB extracted from dlrsd.zip. Reproduce with
# scripts/00_extract_data.py rather than cloning it.
data/

# Recognition caches: regenerable and keyed by the settings that produced them.
# artifacts/step0* and artifacts/step1* ARE tracked because
# artifacts/step1_sam3_text is the hand-off.
artifacts/auto_masks/
artifacts/concept_masks/

# The SAM 3 weights, copied into the project so a run does not depend on the
# Hugging Face cache. 3.3 GB -- reproduce it, never commit it. The *.safetensors
# rule below would catch the weights but not the tokenizer and config JSONs.
SAM-modals/
sam3/
sam3_working_in_shavak/

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

*.pth
*.pt
*.ckpt
*.safetensors
*.zip

.vscode/
.idea/
.DS_Store
